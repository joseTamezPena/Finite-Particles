%[text] # One Charged Plate and a Point Particle
% The variables
% a : angle of point in plate
% d : distance from plate to particle
% v : relative particle velocity [0...1]
% v_a: change in velocity due to aceleration v_a = a*Dt = a*R/C
% r : radial distance between axis to point in plate
syms a d v v_a r real positive;
assume(d>0)
assume(r>=0)
assume(v>=0)
assumeAlso (v < 1)
assume(a>=0)
taylorOrder = 9;

% Particle velocity
vp = [v,0,0];
%%
%[text] ## The vectors
%[text] d= distance from the charge to the plate
%[text] r = radius of a circle in the plate
%[text] The speed of light is 1 (c=1)
%[text] 
R = (d^2+r^2)^(1/2) % total distance from a point in the plate to the charge %[output:1486bb80]

% Get two points per circle. 
% a is the angle
vec_l1 = [d,r*cos(a),r*sin(a)]/R  % velocity vector of light from a point 1 in left positive plate at angle a %[output:2f6b535a]
simplify(dot(vec_l1,vec_l1)) %[output:2c1a46e7]
vec_l2 = [d,-r*cos(a),-r*sin(a)]/R  % velocity vector of light from a point 2 in left positive plate at 180+a %[output:37016ab1]
r_vec_l1 = (vec_l1 - vp) % left plate relative velocity of 1 particle (v in light speed fraction =v/c) %[output:7422cb0f]
r_vec_l2 = (vec_l2 - vp) % left plate relative velocity of 2 particle (v in light speed fraction =v/c) %[output:7967aa42]

%%
%[text] ## The Cosine Square
% 1 particle disparity between photon angle and trayectory
dprd_l1 = simplify(simplifyFraction(dot(vec_l1,r_vec_l1)^2/dot(r_vec_l1,r_vec_l1))) % Cosine^2 left plate %[output:2a68eaec]



% 2 particle disparity between photon angle and trayectory
dprd_l2 = simplify(simplifyFraction(dot(vec_l2,r_vec_l2)^2/dot(r_vec_l2,r_vec_l2))) % Cosine^2 left plate %[output:2ed36f0e]


%%
%[text] ## The Relative Net Force of the Two Points
% Force of the two point in plate and moving particle
dforce = ((dprd_l1/R^2)*vec_l1 + (dprd_l2/R^2)*vec_l2); % net Force in the x direction first points.
dforce = simplify(expand(dforce),'Steps',100) % Two charges %[output:3ea16484]
dforce_x = dforce(1) %[output:44c60e43]
dforce_x = simplify(taylor(expand(subs(dforce_x/2,v,v+v_a) + dforce_x/2),v_a,order=2)) %[output:4bc8b570]
%%
%[text] ## Check at v = 0, r =0
df_v_zero = simplify(subs(dforce_x,[v,r],[0,0]),'Steps',100) % Due to the two point charges %[output:1f995311]
df_v_one = simplify(subs(dforce_x,[v,r],[v,0]),'Steps',100) % Due to the two point charges %[output:42f8c719]
%%
%[text] ## Integrate all the angles
%dforce_xT = expand(taylor(dforce_x,v,Order=taylorOrder));
dforce_xT = dforce_x;

dcircle = int(dforce_xT,a,0,pi); % From zero to pi i.e., the full circle
%%
dcircle = simplify(dcircle,steps=100); % Net force of the two full circles with charge density
df_v_zero = simplify(subs(dcircle,[v,r],[v,0]),'Steps',100) % Net force of the full zero radius circle (point) %[output:37de9632]
%[text] ## 
%%
%[text] ## Integrate for all values of r

dtotf = (r*dcircle)/(2*pi)  %[output:60593555]
dtotf = expand(taylor(dtotf,v,Order=taylorOrder)); % Taylor
totf = int(dtotf,r,0,r); % Add all the circles
totf = simplify(totf); % The force on a charge due a charge surface density

%%
%[text] ## Set the Plates Radius to Infinity
sympref('PolynomialDisplayStyle', 'ascend');
totfInf = simplify(limit(totf,r,Inf)) % Net force by plate charge density %[output:0045b6e2]
acelterm = simplify(- (2*v*v_a)/3 -  (3*v^2*v_a)/4  + (4*v^3*v_a)/15  + (5*v^4*v_a)/6 + (2*v^5*v_a)/35 - (7*v^6*v_a)/12 + (8*v^7*v_a)/315  + (3*v^8*v_a)/5) %[output:1286d87e]
acelterm0 = subs(acelterm,v_a,1) %[output:3545011f]

noacelterm = simplify(totfInf-acelterm) %[output:6f8cafdd]

totfInfV0 = subs(noacelterm,v=0) %[output:076b3b2f]

totfInfRel = simplify(noacelterm/totfInfV0) %[output:1fcbc746]
%%
figure(1)
plotrange = [0,0.99];
fplot(1.0/totfInfRel,plotrange) %[output:2ce89a75]
hold on %[output:2ce89a75]
relEq = 1.0/sqrt(1-v^2) %[output:2543cef1]
relEqApx = taylor(relEq,v,Order=taylorOrder) %[output:05b056f7]
fplot(relEq,plotrange) %[output:2ce89a75]
fplot(relEqApx,plotrange) %[output:2ce89a75]
%fplot(1.0/(totfInfRel+acelterm0),plotrange)
xlabel('v/c')  %[output:2ce89a75]
ylabel('ratio')  %[output:2ce89a75]
legend({'Force Carriers',"Lorentz Mass","Lorentz Apx"},'Location','northeast') %[output:2ce89a75]
hold off %[output:2ce89a75]



%[text] ## Set the Plates Radius to d
totf_d = simplify(limit(totf,r,d)) % Net force by plate charge density %[output:88901c24]
totf_dV0 = subs(totf_d,v=0) %[output:23e8329e]

totf_dRel = simplify(totf_d/totf_dV0) %[output:4d6e48e5]
totf_dRel0 = subs(totf_dRel,v_a,0) %[output:228d913e]

%%
%[text] ## Plots
figure(1)
plotrange = [0,0.99];
fplot(1.0/totfInfRel,plotrange) %[output:7e57bf4b]
hold on %[output:7e57bf4b]
relEq = 1.0/sqrt(1-v^2) %[output:33039637]
relEqApx = taylor(relEq,v,Order=taylorOrder) %[output:3f29c5fd]
fplot(relEq,plotrange) %[output:7e57bf4b]
fplot(relEqApx,plotrange) %[output:7e57bf4b]
fplot(1.0/totf_dRel0,plotrange) %[output:7e57bf4b]
xlabel('v/c')  %[output:7e57bf4b]
ylabel('ratio')  %[output:7e57bf4b]
legend({'Force Carriers',"Lorentz Mass","Lorentz Apx","Fd"},'Location','northeast') %[output:7e57bf4b]
hold off %[output:7e57bf4b]
%[text] ## 
%%
%[text] ## 

%[appendix]{"version":"1.0"}
